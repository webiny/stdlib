{
  "name": "@webiny/utils-node",
  "version": "0.0.0",
  "type": "module",
  "description": "Node.js utils used by Webiny, dependency injection based",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@webiny/di": "^0.2.3",
    "@webiny/utils-common": "0.0.0",
    "fast-glob": "^3.3.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "type-fest": "^5.6.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@typescript/native-preview": "beta",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "build": "tsgo -b --force",
