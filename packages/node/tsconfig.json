{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "paths": {
      "~/*": ["./src/*"],
      "@webiny/utils-common/*": ["../common/src/*"],
      "@webiny/utils-common": ["../common/src/index.js"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "../common" }]
}
