{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext", "dom"],
    "paths": {
      "~/common": ["./src/index.js"],
      "~/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["src/node", "src/browser"]
}
